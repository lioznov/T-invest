# Read-only T-Invest token. Never commit a real token.
INVEST_TOKEN=
# Alternatively set INVEST_ENV_FILE to the absolute path of your existing .env.
# Same bot and destination as the radar. Never put real credentials in Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Candidate notifications are opt-in on the website. Broker orders are never placed.
# VK community token with Messages permission; never use a personal account password.
VK_COMMUNITY_TOKEN=
# Positive numeric ID of your own VK user account, not the community or chat ID.
VK_USER_ID=
